NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- ESPN import (one-off, local only) -------------------------------------
# Needed to read a private league. Copy this file to `.env.local` and fill
# these in — `.env.local` is gitignored, so they never leave your machine.
#
# To find them: log in at fantasy.espn.com, open DevTools (F12), then
# Application > Storage > Cookies > https://fantasy.espn.com
#
# Wrap SWID in quotes — it contains curly braces.
ESPN_LEAGUE_ID=803871539
ESPN_S2=
SWID=""

# --- Draft War Room (private draft board behind the padlock) ----------------
# Access code for the /draft/war-room page. Falls back to a default if unset.
NEXT_PUBLIC_WAR_ROOM_CODE=hornpub2026

# Optional live cross-device sync of the drafted list. Leave blank to run the
# board purely on localStorage (single device). To enable, create a Supabase
# project and a `war_room_board` table (schema in lib/draft/war-room-sync.ts),
# then fill these in:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
