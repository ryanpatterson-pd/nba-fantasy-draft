NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- ESPN import (one-off, local only) -------------------------------------
# Needed to read a private league. Copy this file to `.env.local` and fill
# these in — `.env.local` is gitignored, so they never leave your machine.
#
# To find them: log in at fantasy.espn.com, open DevTools (F12), then
# Application > Storage > Cookies > https://fantasy.espn.com
#
# Wrap SWID in quotes — it contains curly braces.
ESPN_LEAGUE_ID=803871539
ESPN_S2=
SWID=""

# Add these when Supabase is introduced:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
